mncs 0.8;

// PRESS-004 historical reproducer: integer bitwise operators were once
// unavailable. The current Profile 0.18 toolchain accepts all three u64
// operators; the source header remains 0.8 to prove the fix applies without
// a profile bump. mncs-index now consumes the capability in digest/scan.
module pressure.int_bitwise;

fn xor_u64(a: u64, b: u64) -> (result: u64) {
    return a ^ b;
}

// Slice-7 extension (2026-09-08): stage-b1 made `& |` total over all
// integer widths too, so the full operator family is pinned here.
fn and_u64(a: u64, b: u64) -> (result: u64) {
    return a & b;
}

fn or_u64(a: u64, b: u64) -> (result: u64) {
    return a | b;
}
